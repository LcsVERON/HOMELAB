# The loopback network interface
auto lo
iface lo inet loopback

# The primary network interface
auto eth0
iface eth0 inet static
    address 10.10.30.20 # after step 10
    # address 10.10.20.20 before step 10
    netmask 255.255.255.0
    gateway 10.10.30.1 # after step 10
    # gateway 10.10.20.1 before step 10